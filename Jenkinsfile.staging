// Staging deployment pipeline for 42d6f3fc-6853-4abf-a5bf-9e132af66c77 — generated by tediux.
//
// This is the SMALL pipeline: it deploys straight to the staging server and
// lets the target build incrementally (unchanged services rebuild from cache
// in seconds), gated by a strict health check with automatic image rollback.
// Production (Jenkinsfile.production) adds a full CI build + smoke test gate.
//
// Job setup (Pipeline from SCM, script path: Jenkinsfile.staging):
//   Credentials : an SSH key credential for the staging server
//                 (default ID: staging-server-ssh)
//   Parameters  : DEPLOY_HOST (staging server IP/host)  [required]
//                 DEPLOY_USER (default ubuntu)
//                 SSH_PORT    (default 22)
//                 DOMAIN_NAME (optional — activates Traefik Host() routing
//                              and TLS; leave empty for port-only ingress)
//   The gateway port 21631 is baked in at project generation.
//
// Correctness notes (each one learned from a live failure — keep them):
//   * In Groovy triple-quoted strings a single backslash before a paren is
//     an ILLEGAL escape — regex parens must use a doubled backslash so the
//     shell receives a single one.
//   * The health gate must match '(healthy)' literally — a bare grep for
//     "healthy" also counts "unhealthy" and passes broken deploys.
//   * Workspace cleanup lives in post.cleanup, which runs LAST — post.always
//     runs BEFORE post.failure and would delete the .deploy-started marker
//     the rollback handler depends on.
//   * Do not add 'traefik.docker.allownonrunning' labels unless the target
//     Traefik is >= 3.6 — older versions skip the whole container.

pipeline {
    agent any
    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '5'))
        timeout(time: 30, unit: 'MINUTES')
    }
    parameters {
        string(name: 'DEPLOY_HOST', defaultValue: '', description: 'Staging server host/IP (required)')
        string(name: 'DEPLOY_USER', defaultValue: 'ubuntu', description: 'SSH user on the staging server')
        string(name: 'SSH_PORT', defaultValue: '22', description: 'SSH port')
        string(name: 'SSH_CREDENTIAL_ID', defaultValue: 'staging-server-ssh', description: 'Jenkins SSH key credential ID')
        string(name: 'DOMAIN_NAME', defaultValue: '', description: 'Optional: staging FQDN for Traefik Host() routing + TLS')
    }
    environment {
        DEPLOY_DIR = "${JOB_NAME}-staging"
        GATEWAY_PORT = '21631'
    }
    stages {
        stage('Validate') {
            steps {
                sh """
                    test -n "${params.DEPLOY_HOST}" || { echo "DEPLOY_HOST parameter is required"; exit 1; }
                    cd \$WORKSPACE
                    docker compose -f docker-compose.prod.yml config --quiet
                    docker compose -f docker-compose.prod.yml -f docker-compose.staging.yml config --quiet
                    echo "Compose config: VALID"
                """
            }
        }
        stage('Deploy') {
            steps {
                sshagent(credentials: [params.SSH_CREDENTIAL_ID]) {
                    // Ship the workspace to the target.
                    sh """
                        tar czf /tmp/${DEPLOY_DIR}-src.tar.gz -C \$WORKSPACE --exclude=.git --exclude=node_modules --exclude=.next .
                        ssh -o StrictHostKeyChecking=no -p ${params.SSH_PORT} ${params.DEPLOY_USER}@${params.DEPLOY_HOST} "mkdir -p ~/deployments/${DEPLOY_DIR}"
                        scp -o StrictHostKeyChecking=no -P ${params.SSH_PORT} /tmp/${DEPLOY_DIR}-src.tar.gz ${params.DEPLOY_USER}@${params.DEPLOY_HOST}:/tmp/
                        ssh -o StrictHostKeyChecking=no -p ${params.SSH_PORT} ${params.DEPLOY_USER}@${params.DEPLOY_HOST} "cd ~/deployments/${DEPLOY_DIR} && tar xzf /tmp/${DEPLOY_DIR}-src.tar.gz && rm /tmp/${DEPLOY_DIR}-src.tar.gz"
                        rm -f /tmp/${DEPLOY_DIR}-src.tar.gz
                    """
                    // Snapshot current images as :rollback BEFORE building over
                    // them; the .deploy-started marker gates the rollback
                    // handler so pre-deploy failures can never trigger it.
                    // ROUTER_PREFIX derives from DOMAIN_NAME (dots -> dashes).
                    sh """
                        ssh -o StrictHostKeyChecking=no -p ${params.SSH_PORT} ${params.DEPLOY_USER}@${params.DEPLOY_HOST} \\
                          "docker images --format '{{.Repository}}' | grep '^${DEPLOY_DIR}-' | sort -u | xargs -r -I@ docker tag @:latest @:rollback" || true
                        touch \$WORKSPACE/.deploy-started
                        DOMAIN='${params.DOMAIN_NAME}'
                        EXPORTS=""
                        if [ -n "\$DOMAIN" ]; then
                            PREFIX=\$(echo "\$DOMAIN" | tr '.:' '--')
                            # PUBLIC_URL is what docker-compose.staging.yml resolves
                            # CORS_ORIGINS/FRONTEND_URL from. staging.yml is the later
                            # -f, so it wins over prod.yml's https://\$DOMAIN_NAME —
                            # without this the site would reject its own origin.
                            EXPORTS="export DOMAIN_NAME='\$DOMAIN' ROUTER_PREFIX='\$PREFIX' PUBLIC_URL='https://\$DOMAIN' && "
                        fi
                        ssh -o StrictHostKeyChecking=no -p ${params.SSH_PORT} ${params.DEPLOY_USER}@${params.DEPLOY_HOST} \\
                          "docker network create traefik-public 2>/dev/null || true && \\
                           cd ~/deployments/${DEPLOY_DIR} && \\
                           \${EXPORTS}docker compose -f docker-compose.prod.yml -f docker-compose.staging.yml build && \\
                           \${EXPORTS}docker compose -f docker-compose.prod.yml -f docker-compose.staging.yml up -d --remove-orphans"
                    """
                }
            }
        }
        stage('Health Check') {
            steps {
                sshagent(credentials: [params.SSH_CREDENTIAL_ID]) {
                    // Strict gate: at least one (healthy) container AND none
                    // unhealthy, restarting, or exited non-zero.
                    sh """
                        for i in \$(seq 1 18); do
                            PS=\$(ssh -o StrictHostKeyChecking=no -p ${params.SSH_PORT} ${params.DEPLOY_USER}@${params.DEPLOY_HOST} \\
                              "cd ~/deployments/${DEPLOY_DIR} && docker compose -f docker-compose.prod.yml -f docker-compose.staging.yml ps 2>/dev/null" || true)
                            HEALTHY=\$(echo "\$PS" | grep -c '(healthy)' || true)
                            BAD=\$(echo "\$PS" | grep -cE '\\(unhealthy\\)|Restarting|Exited \\([1-9]' || true)
                            echo "Health: \$HEALTHY healthy, \$BAD failing (attempt \$i/18)"
                            if [ "\$HEALTHY" -gt 0 ] && [ "\$BAD" -eq 0 ] 2>/dev/null; then
                                echo "Deployment healthy!"
                                ssh -o StrictHostKeyChecking=no -p ${params.SSH_PORT} ${params.DEPLOY_USER}@${params.DEPLOY_HOST} "docker image prune -f >/dev/null" || true
                                exit 0
                            fi
                            sleep 10
                        done
                        echo "Health check failed after 3 minutes"
                        exit 1
                    """
                }
            }
        }
    }
    post {
        failure {
            sshagent(credentials: [params.SSH_CREDENTIAL_ID]) {
                sh """
                    if [ -f \$WORKSPACE/.deploy-started ]; then
                        echo "=== ROLLING BACK to pre-deploy images ==="
                        ssh -o StrictHostKeyChecking=no -p ${params.SSH_PORT} ${params.DEPLOY_USER}@${params.DEPLOY_HOST} \\
                          "docker images --format '{{.Repository}}' | grep '^${DEPLOY_DIR}-' | sort -u | xargs -r -I@ docker tag @:rollback @:latest" || true
                        ssh -o StrictHostKeyChecking=no -p ${params.SSH_PORT} ${params.DEPLOY_USER}@${params.DEPLOY_HOST} \\
                          "cd ~/deployments/${DEPLOY_DIR} && docker compose -f docker-compose.prod.yml -f docker-compose.staging.yml up -d --no-build --remove-orphans" || true
                    fi
                """
                sh """
                    echo "=== CONTAINER STATUS ==="
                    ssh -o StrictHostKeyChecking=no -p ${params.SSH_PORT} ${params.DEPLOY_USER}@${params.DEPLOY_HOST} \\
                      "cd ~/deployments/${DEPLOY_DIR} && docker compose -f docker-compose.prod.yml -f docker-compose.staging.yml ps -a" 2>/dev/null || true
                    echo "=== SERVICE LOGS ==="
                    ssh -o StrictHostKeyChecking=no -p ${params.SSH_PORT} ${params.DEPLOY_USER}@${params.DEPLOY_HOST} \\
                      "cd ~/deployments/${DEPLOY_DIR} && docker compose -f docker-compose.prod.yml -f docker-compose.staging.yml logs --tail=20" 2>/dev/null || true
                """
            }
        }
        cleanup {
            // Runs LAST — the failure handler above needs .deploy-started.
            cleanWs()
        }
    }
}
