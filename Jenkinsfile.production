// Production deployment pipeline for 42d6f3fc-6853-4abf-a5bf-9e132af66c77 — generated by tediux.
//
// The FULL pipeline: images are built and smoke-tested ON JENKINS before the
// production server is touched — if anything fails, production never changes.
// Deploys use --force-recreate and the same strict health gate + image
// rollback as staging (Jenkinsfile.staging documents the correctness rules;
// they all apply here too).
//
// Job setup (Pipeline from SCM, script path: Jenkinsfile.production):
//   Credentials : an SSH key credential for the production server
//   Parameters  : DEPLOY_HOST, DEPLOY_USER, SSH_PORT, SSH_CREDENTIAL_ID,
//                 DOMAIN_NAME (production FQDN — required for Traefik
//                 Host() routing and TLS via the myresolver cert resolver)

pipeline {
    agent any
    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '5'))
        timeout(time: 30, unit: 'MINUTES')
    }
    parameters {
        string(name: 'DEPLOY_HOST', defaultValue: '', description: 'Production server host/IP (required)')
        string(name: 'DEPLOY_USER', defaultValue: 'ubuntu', description: 'SSH user on the production server')
        string(name: 'SSH_PORT', defaultValue: '22', description: 'SSH port')
        string(name: 'SSH_CREDENTIAL_ID', defaultValue: 'production-server-ssh', description: 'Jenkins SSH key credential ID')
        string(name: 'DOMAIN_NAME', defaultValue: '', description: 'Production FQDN (required): Traefik Host() routing + TLS')
    }
    environment {
        DEPLOY_DIR = "${JOB_NAME}"
        CI_PROJECT = "${JOB_NAME}-ci"
        GATEWAY_PORT = '21631'
    }
    stages {
        stage('Validate') {
            steps {
                sh """
                    test -n "${params.DEPLOY_HOST}" || { echo "DEPLOY_HOST parameter is required"; exit 1; }
                    test -n "${params.DOMAIN_NAME}" || { echo "DOMAIN_NAME parameter is required for production"; exit 1; }
                    cd \$WORKSPACE
                    docker compose -f docker-compose.prod.yml config --quiet
                    echo "Compose config: VALID"
                """
            }
        }
        stage('CI Build and Smoke Test') {
            steps {
                // Build and boot the whole stack HERE — Dockerfile errors,
                // missing dependencies and crash-on-start containers are all
                // caught before production is touched.
                sh """
                    cd \$WORKSPACE
                    docker compose -f docker-compose.prod.yml build
                    docker network create traefik-public 2>/dev/null || true
                    docker compose -f docker-compose.prod.yml -p ${CI_PROJECT} up -d --remove-orphans
                """
                sh """
                    PASSED=0
                    for i in \$(seq 1 12); do
                        PS=\$(docker compose -f \$WORKSPACE/docker-compose.prod.yml -p ${CI_PROJECT} ps 2>/dev/null || true)
                        HEALTHY=\$(echo "\$PS" | grep -c '(healthy)' || true)
                        BAD=\$(echo "\$PS" | grep -cE '\\(unhealthy\\)|Restarting|Exited \\([1-9]' || true)
                        echo "CI smoke test: \$HEALTHY healthy, \$BAD failing (attempt \$i/12)"
                        if [ "\$HEALTHY" -gt 0 ] && [ "\$BAD" -eq 0 ] 2>/dev/null; then
                            PASSED=1; break
                        fi
                        if [ "\$BAD" -gt 0 ] && [ "\$i" -gt 3 ] 2>/dev/null; then
                            echo "CI smoke test: containers crashing, failing fast"; break
                        fi
                        sleep 10
                    done
                    if [ "\$PASSED" -eq 0 ]; then
                        echo "=== CI SMOKE TEST FAILED ==="
                        docker compose -f \$WORKSPACE/docker-compose.prod.yml -p ${CI_PROJECT} ps -a || true
                        docker compose -f \$WORKSPACE/docker-compose.prod.yml -p ${CI_PROJECT} logs --tail=30 || true
                        exit 1
                    fi
                """
            }
        }
        stage('Deploy') {
            steps {
                sshagent(credentials: [params.SSH_CREDENTIAL_ID]) {
                    sh """
                        tar czf /tmp/${DEPLOY_DIR}-src.tar.gz -C \$WORKSPACE --exclude=.git --exclude=node_modules --exclude=.next .
                        ssh -o StrictHostKeyChecking=no -p ${params.SSH_PORT} ${params.DEPLOY_USER}@${params.DEPLOY_HOST} "mkdir -p ~/deployments/${DEPLOY_DIR}"
                        scp -o StrictHostKeyChecking=no -P ${params.SSH_PORT} /tmp/${DEPLOY_DIR}-src.tar.gz ${params.DEPLOY_USER}@${params.DEPLOY_HOST}:/tmp/
                        ssh -o StrictHostKeyChecking=no -p ${params.SSH_PORT} ${params.DEPLOY_USER}@${params.DEPLOY_HOST} "cd ~/deployments/${DEPLOY_DIR} && tar xzf /tmp/${DEPLOY_DIR}-src.tar.gz && rm /tmp/${DEPLOY_DIR}-src.tar.gz"
                        rm -f /tmp/${DEPLOY_DIR}-src.tar.gz
                    """
                    sh """
                        ssh -o StrictHostKeyChecking=no -p ${params.SSH_PORT} ${params.DEPLOY_USER}@${params.DEPLOY_HOST} \\
                          "docker images --format '{{.Repository}}' | grep '^${DEPLOY_DIR}-' | sort -u | xargs -r -I@ docker tag @:latest @:rollback" || true
                        touch \$WORKSPACE/.deploy-started
                        PREFIX=\$(echo "${params.DOMAIN_NAME}" | tr '.:' '--')
                        ssh -o StrictHostKeyChecking=no -p ${params.SSH_PORT} ${params.DEPLOY_USER}@${params.DEPLOY_HOST} \\
                          "docker network create traefik-public 2>/dev/null || true && \\
                           cd ~/deployments/${DEPLOY_DIR} && \\
                           export DOMAIN_NAME='${params.DOMAIN_NAME}' ROUTER_PREFIX='\$PREFIX' && \\
                           docker compose -f docker-compose.prod.yml build && \\
                           docker compose -f docker-compose.prod.yml up -d --force-recreate --remove-orphans"
                    """
                }
            }
        }
        stage('Health Check') {
            steps {
                sshagent(credentials: [params.SSH_CREDENTIAL_ID]) {
                    sh """
                        for i in \$(seq 1 18); do
                            PS=\$(ssh -o StrictHostKeyChecking=no -p ${params.SSH_PORT} ${params.DEPLOY_USER}@${params.DEPLOY_HOST} \\
                              "cd ~/deployments/${DEPLOY_DIR} && docker compose -f docker-compose.prod.yml ps 2>/dev/null" || true)
                            HEALTHY=\$(echo "\$PS" | grep -c '(healthy)' || true)
                            BAD=\$(echo "\$PS" | grep -cE '\\(unhealthy\\)|Restarting|Exited \\([1-9]' || true)
                            echo "Health: \$HEALTHY healthy, \$BAD failing (attempt \$i/18)"
                            if [ "\$HEALTHY" -gt 0 ] && [ "\$BAD" -eq 0 ] 2>/dev/null; then
                                echo "Deployment healthy!"
                                ssh -o StrictHostKeyChecking=no -p ${params.SSH_PORT} ${params.DEPLOY_USER}@${params.DEPLOY_HOST} "docker image prune -f >/dev/null" || true
                                exit 0
                            fi
                            sleep 10
                        done
                        echo "Health check failed after 3 minutes"
                        exit 1
                    """
                }
            }
        }
    }
    post {
        always {
            // CI containers are torn down whatever happened; volumes too, so
            // a rerun never inherits state from a failed smoke test.
            sh """
                docker compose -f \$WORKSPACE/docker-compose.prod.yml -p ${CI_PROJECT} down --remove-orphans --volumes 2>/dev/null || true
            """
        }
        failure {
            sshagent(credentials: [params.SSH_CREDENTIAL_ID]) {
                sh """
                    if [ -f \$WORKSPACE/.deploy-started ]; then
                        echo "=== ROLLING BACK to pre-deploy images ==="
                        ssh -o StrictHostKeyChecking=no -p ${params.SSH_PORT} ${params.DEPLOY_USER}@${params.DEPLOY_HOST} \\
                          "docker images --format '{{.Repository}}' | grep '^${DEPLOY_DIR}-' | sort -u | xargs -r -I@ docker tag @:rollback @:latest" || true
                        ssh -o StrictHostKeyChecking=no -p ${params.SSH_PORT} ${params.DEPLOY_USER}@${params.DEPLOY_HOST} \\
                          "cd ~/deployments/${DEPLOY_DIR} && docker compose -f docker-compose.prod.yml up -d --no-build --remove-orphans" || true
                    fi
                """
                sh """
                    echo "=== CONTAINER STATUS ==="
                    ssh -o StrictHostKeyChecking=no -p ${params.SSH_PORT} ${params.DEPLOY_USER}@${params.DEPLOY_HOST} \\
                      "cd ~/deployments/${DEPLOY_DIR} && docker compose -f docker-compose.prod.yml ps -a" 2>/dev/null || true
                    echo "=== SERVICE LOGS ==="
                    ssh -o StrictHostKeyChecking=no -p ${params.SSH_PORT} ${params.DEPLOY_USER}@${params.DEPLOY_HOST} \\
                      "cd ~/deployments/${DEPLOY_DIR} && docker compose -f docker-compose.prod.yml logs --tail=20" 2>/dev/null || true
                """
            }
        }
        cleanup {
            // Runs LAST — the failure handler above needs .deploy-started.
            cleanWs()
        }
    }
}
